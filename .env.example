# Create a bot with @BotFather in Telegram and paste its token here.
# This token is a password for your bot. Never share it or commit this file.
TELEGRAM_BOT_TOKEN=

# Send /start to your bot, then run `npm run telegram:chat-id` to find this.
TELEGRAM_CHAT_ID=

# Seconds between full passes over all ten listings. Values below 30 are rejected.
POLL_INTERVAL_SECONDS=30

# Optional random delay added to each interval so rounds are not exactly periodic.
POLL_JITTER_SECONDS=0

# How long a single Lazada page load may take before the check is abandoned.
NAVIGATION_TIMEOUT_MS=25000

# --- Public restock feed recorder (npm run feed:watch) ---

# The @name of a public restock channel, without the @. Its posts are read from
# the same t.me preview page any visitor sees; no account or token is involved.
FEED_CHANNEL_HANDLE=

# Seconds between fetches of the preview page. Values below 30 are raised to 30.
FEED_POLL_SECONDS=60

# Where the JSONL dataset of observed drops is appended.
FEED_DATASET_PATH=feed/restocks.jsonl

# Pause between consecutive listings inside one round, in milliseconds.
# Unset spreads the round across the interval; setting it pins the gap. This
# changes how the round is distributed, never how many requests it makes.
# LISTING_SPACING_MS=200

# How many listings to check at once. Each one gets its own browser page,
# so raising this uses more memory. Spacing still applies between requests.
CHECK_CONCURRENCY=1
